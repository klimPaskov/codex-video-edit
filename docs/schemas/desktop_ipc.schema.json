        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response",
        "payload"
      ],
      "properties": {
        "channel": {
          "const": "codex:select"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "$ref": "#/$defs/codexView"
                }
              }
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/codexSelection"
        }
      }
    }
  ],
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "width",
        "height",
        "durationUs",
        "frameRate",
        "previewAvailable"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\\\x00-\\x1f]+$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "durationUs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "frameRate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "previewAvailable": {
          "type": "boolean"
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "rgbaBase64"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "rgbaBase64": {
          "type": "string",
          "minLength": 8,
          "maxLength": 89478488,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      },
      "description": "Runtime additionally checks width * height <= 16777216, exact base64 length 4 * ceil(width * height * 4 / 3), and padding for the byte count. JSON Schema alone does not establish decoded frame equality."
    },
    "frameRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "timeUs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "timeUs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "message"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "message": {
          "type": "string",
          "maxLength": 240,
          "minLength": 1
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interfaceScale"
      ],
      "properties": {
        "interfaceScale": {
          "type": "number",
          "enum": [
            1,
            1.25,
            1.5,
            2
          ]
        }
      }
    },
    "projectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "description": "For projects:create, id is an imported media ID. For projects:open, id is a project ID. Paths are never accepted."
    },
    "projectNavigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "stage": {
          "enum": [
            "record_import",
            "auto_edit",
            "edit",
            "review",
            "export"
          ]
        }
      }
    },
    "projectView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "stage",
        "revisionId",
        "source",
        "timeline"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^/\\\\\\x00-\\x1f]+$"
        },
        "stage": {
          "enum": [
            "record_import",
            "auto_edit",
            "edit",
            "review",
            "export"
          ]
        },
        "revisionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "source": {
          "$ref": "#/$defs/summary"
        },
        "timeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "durationUs",
            "frameRate"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "durationUs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "frameRate": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "numerator",
                "denominator"
              ],
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        }
      },
      "description": "Path-free committed project view. Runtime additionally requires project, revision, source and timeline IDs to be distinct. A stage identifies navigation, not successful feature execution or export."
    },
    "codexView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection",
        "account",
        "plan",
        "busy",
        "message",
        "models",
        "skills",
        "limits",
        "selection"
      ],
      "properties": {
        "connection": {
          "enum": [
            "disconnected",
            "connected",
            "unavailable"
          ]
        },
        "account": {
          "enum": [
            "unknown",
            "signed_out",
            "signing_in",
            "signed_in"
          ]
        },
        "plan": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "busy": {
          "type": "boolean"
        },
        "message": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "models": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "reasoning",
              "defaultReasoning"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "reasoning": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "uniqueItems": true
              },
              "defaultReasoning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "enabled"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "description": {
                "type": "string",
                "maxLength": 16384
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        },
        "limits": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "remainingPercent",
              "resetsAt"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "remainingPercent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "resetsAt": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "selection": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "modelId",
                "reasoning"
              ],
              "properties": {
                "modelId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "reasoning": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "account": {
                "const": "signed_in"
              }
            }
          },
          "then": {
            "properties": {
              "connection": {
                "const": "connected"
              }
            }
          },
          "else": {
            "properties": {
              "plan": {
                "type": "null"
              },
              "models": {
                "maxItems": 0
              },
              "limits": {
                "maxItems": 0
              }
            }
          }
        }
      ],
