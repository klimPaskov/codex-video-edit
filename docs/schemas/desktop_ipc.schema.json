      ],
      "properties": {
        "channel": {
          "const": "codex:cancel-login"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "$ref": "#/$defs/codexView"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response"
      ],
      "properties": {
        "channel": {
          "const": "codex:logout"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "$ref": "#/$defs/codexView"
                }
              }
            }
