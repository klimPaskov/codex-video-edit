{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-video-edit.local/schemas/desktop_ipc.schema.json",
  "title": "Desktop library, project, preferences and Codex settings IPC exchange",
  "description": "Contract documentation envelope for a native IPC request and response. Electron channel and request are separate arguments at runtime; absent payload represents undefined, never null. No source filesystem path crosses this boundary. Runtime also validates trusted main-frame sender and source-specific seek bounds.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response"
      ],
      "properties": {
        "channel": {
          "const": "library:list"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "type": "array",
                  "maxItems": 10000,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/summary"
                  },
                  "description": "Runtime additionally rejects duplicate IDs even if the other summary fields differ."
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response"
      ],
      "properties": {
        "channel": {
          "const": "library:import"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/summary"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response",
        "payload"
      ],
      "properties": {
        "channel": {
          "const": "library:frame"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "$ref": "#/$defs/frame"
                }
              }
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/frameRequest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response"
      ],
      "properties": {
        "channel": {
          "const": "library:cancel"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "type": "null"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response"
      ],
      "properties": {
        "channel": {
          "const": "preferences:get"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "$ref": "#/$defs/preferences"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response",
        "payload"
      ],
      "properties": {
        "channel": {
          "const": "preferences:set"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "$ref": "#/$defs/preferences"
                }
              }
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/preferences"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response"
      ],
      "properties": {
        "channel": {
          "const": "projects:list"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "type": "array",
                  "maxItems": 1000,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/projectView"
                  },
                  "description": "Runtime additionally rejects duplicate project IDs even when other view fields differ."
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response",
        "payload"
      ],
      "properties": {
        "channel": {
          "const": "projects:create"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "$ref": "#/$defs/projectView"
                }
              }
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/projectRequest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response",
        "payload"
      ],
      "properties": {
        "channel": {
          "const": "projects:open"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "$ref": "#/$defs/projectView"
                }
              }
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/projectRequest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response",
        "payload"
      ],
      "properties": {
        "channel": {
          "const": "projects:navigate"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "$ref": "#/$defs/projectView"
                }
              }
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/projectNavigation"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response"
      ],
      "properties": {
        "channel": {
          "const": "codex:get"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "$ref": "#/$defs/codexView"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response"
      ],
      "properties": {
        "channel": {
          "const": "codex:reconnect"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "$ref": "#/$defs/codexView"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "response"
      ],
      "properties": {
        "channel": {
          "const": "codex:login"
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok",
                "value"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "value": {
                  "$ref": "#/$defs/codexView"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
