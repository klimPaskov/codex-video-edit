{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guarded Codex tool manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tools"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "mode",
          "description",
          "undoable",
          "user_confirmation",
          "allowed_scope"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          },
          "mode": {
            "enum": [
              "read",
              "mutation",
              "analysis",
              "render",
              "qa",
              "export_prepare"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "undoable": {
            "type": "boolean"
          },
          "user_confirmation": {
            "enum": [
              "none",
              "material_change",
              "always"
            ]
          },
          "allowed_scope": {
            "enum": [
              "project_read",
              "active_draft",
              "bounded_media",
              "local_assets",
              "export_staging"
            ]
          },
          "input_schema": {
            "type": "string"
          },
          "output_schema": {
            "type": "string"
          },
          "forbidden_effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "allowed_scope": {
                  "enum": [
                    "active_draft",
                    "export_staging"
                  ]
                }
              },
              "required": [
                "allowed_scope"
              ]
            },
            "then": {
              "properties": {
                "user_confirmation": {
                  "const": "none"
                }
              }
            }
          }
        ]
      }
    }
  }
}
