{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local B-roll or media asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "kind",
    "path",
    "sha256",
    "description",
    "tags",
    "provenance",
    "media"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "kind": {
      "enum": [
        "video",
        "image",
        "audio",
        "music",
        "font",
        "background"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "license",
        "allowed_use",
        "verified_by_user"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "license_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "allowed_use": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_by_user": {
          "type": "boolean"
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_us"
      ],
      "properties": {
        "duration_us": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "has_audio": {
          "type": "boolean"
        }
      }
    },
    "usage_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
